# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/eliteformation"

# CINETPAY_API_KEY: For mobile money payments in Africa
CINETPAY_API_KEY="MY_CINETPAY_KEY"
CINETPAY_SITE_ID="MY_CINETPAY_SITE_ID"
